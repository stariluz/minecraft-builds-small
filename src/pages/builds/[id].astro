---
import Layout from "../../layouts/Layout.astro";
import builds from "../../data/builds.json";
import ImageButton from "../../components/buttons/ImageButton.astro";
import Rating from "../../components/Rating.astro";
import PaypalButton from "../../components/buttons/PaypalButton.astro";
import Tab from "../../components/tabs/Tab.astro";
import Tabs from "../../components/tabs/Tabs.astro";
import TabLink from "../../components/tabs/TabLink.astro";
import IconDiscord from "../../components/icons/IconDiscord.astro";
import Header from "../../components/Header.astro";

export function getStaticPaths() {
	return builds.map((building) => ({
		params: { id: building.id },
	}));
}

interface Params {
	id: number;
}
interface Props {
	building: Building;
}

const { id } = Astro.params;
const building = builds.find((building) => {
	return building.id == id;
}) as Building;
---

<Layout title={building.title}>
	<main class:list={["container"]}>
		<Header class="space"/>
		<main class="detail">
			<section class="gallery">
				<div class="banner">
					<img
						class="banner-image"
						id="banner"
						src={building.images[0]}
						alt="Banner"
					/>
				</div>
				<footer>
					<ul class="gallery-images">
						{
							building.images.map((imageUrl, index) => (
								<li class="gallery-image">
									<ImageButton
										imageUrl={imageUrl}
										index={index}
									/>
								</li>
							))
						}
					</ul>
				</footer>
			</section>
			<section class="content">
				<header class="content-header">
					<h1>{building.title}</h1>
					<Rating value={building.rating} />
				</header>
				<div>
					<p>{building.content.description}</p>
					<p>
						Size: <strong
							>{building.content.dimensions.length}x{
								building.content.dimensions.width
							}x{building.content.dimensions.height}</strong
						>
					</p>
					<p>
						Interiors: <strong>{building.content.interiors}</strong>
					</p>
					<p>
						Versions: <strong>{building.content.versions}</strong>
					</p>
					<ul>
						{
							building.content.characteristics.map(
								(characteristic) => <li>{characteristic}</li>,
							)
						}
					</ul>
				</div>
			</section>
			<section class="pay">
				<PaypalButton class="d-block centered" />
				<div>
					<h4>Things you get</h4>
					<ul>
						<li>Support once verified</li>
						<li>Free access to updates</li>
						<li>Exclusive channels on Discord</li>
						<li>Giveaways on Discord</li>
						<li>Java & Bedrock support</li>
						<li>A great build made by us</li>
					</ul>
				</div>
			</section>

			<section class="extra">
				<Tabs>
					<Fragment slot="tab-menu">
						<TabLink class="active" tabId={"tab1"}>
							Download Files
						</TabLink>
						<TabLink tabId={"tab2"}> 3D Model </TabLink>
						<TabLink tabId={"tab3"}> Support </TabLink>
					</Fragment>

					<Fragment slot="tab-content">
						<Tab class="active" id="tab1">
							<p>
								The files that can be brought are the following:
							</p>
							<h5>Java Schematic:</h5>
							<ul>
								{
									building.downloadData.javaSchematic.map(
										(file) => <li>{file}</li>,
									)
								}
							</ul>
							<h5>Java World:</h5>
							<ul>
								{
									building.downloadData.javaWorld.map(
										(file) => <li>{file}</li>,
									)
								}
							</ul>
							<h5>Minecraft Bedrock:</h5>
							<ul>
								{
									building.downloadData.minecraftBedrock.map(
										(file) => <li>{file}</li>,
									)
								}
							</ul>
						</Tab>
						<Tab id="tab2">
							<p>
								<a class="btn" href={building.threeDModel}>
									Check here the 3D model.
								</a>
							</p>
						</Tab>
						<Tab id="tab3">
							<p>
								Need help? We are here to help you and answer
								any questions.
							</p>
							<a
								class="icon-link"
								href="http://"
								target="_blank"
								rel="noopener noreferrer"
							>
								<IconDiscord />
								<span
									class="icon icon-tablerti ti-brand-discord"
								></span>
								Discord
							</a>
							<!-- <a href="http://" target="_blank" rel="noopener noreferrer">Contact page</a> -->
							<!-- <a href="http://" target="_blank" rel="noopener noreferrer">Wiki</a> -->
						</Tab>
					</Fragment>
				</Tabs>
			</section>

			<section class="reviews"></section>
		</main>
	</main>
</Layout>
<style>
	.detail {
		display: grid;
		grid-template-areas:
			"ga ga ga"
			"co co pa"
			"ex ex pa";
		row-gap: 2rem;
	}
	.gallery {
		grid-area: ga;
	}
	.content {
		grid-area: co;
	}
	.pay {
		grid-area: pa;
	}
	.extra {
		grid-area: ex;
	}
	.banner {
		margin: auto;
		width: 80%;
		aspect-ratio: 16/9;
		overflow: hidden;
	}
	.banner-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	ul.gallery-images {
		padding: 0;
	}
	.gallery-images {
		display: flex;
		justify-content: center;
		align-items: center;
		/* overflow-x: auto; */
		flex-wrap: nowrap;
		gap: 1rem;
		margin: 1rem;
	}
	li.gallery-image {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.gallery-image {
		width: 8%;
		aspect-ratio: 1;
		position: relative;
	}
	.content-header {
		margin-bottom: 2rem;
	}

	h5 {
		font-size: 1rem;
		margin: 0;
	}
	.icon-link {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	a {
		text-decoration: none;
		font-weight: 600;
		color: var(--stari-text-color-link);
	}
</style>
<script>
	const banner = document.getElementById("banner") as HTMLImageElement;
	let lastSelectedIndex: number = 0;
	const $imageButtons = document.querySelectorAll("image-button button");
	$imageButtons[0].classList.add("selected");

	$imageButtons.forEach((button) => {
		button.addEventListener("click", (event) => {
			const target = event.currentTarget as HTMLButtonElement;
			const index = Number(target.dataset.index);
			if (index == lastSelectedIndex) {
				return;
			}
			const imageUrl = target.dataset.imageurl;

			if (imageUrl) {
				banner.src = imageUrl;
				target.classList.add("selected");
				$imageButtons[lastSelectedIndex].classList.remove("selected");
			}
			lastSelectedIndex = index;
		});
	});

	document.querySelectorAll(".tab-link").forEach((button) => {
		button.addEventListener("click", (event) => {
			const target = event.currentTarget as HTMLButtonElement;
			const tabContent = document.querySelector(
				`#${target.dataset.tab}`,
			) as HTMLElement;

			document
				.querySelectorAll(".tab-link")
				.forEach((btn) => btn.classList.remove("active"));
			document
				.querySelectorAll(".tab")
				.forEach((tab) => tab.classList.remove("active"));

			target.classList.add("active");
			tabContent.classList.add("active");
		});
	});
</script>
