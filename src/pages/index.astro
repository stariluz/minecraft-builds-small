---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import builds from "../data/builds.json";
import IconDiscord from "../components/icons/IconDiscord.astro";
import IconShop from "../components/icons/IconShop.astro";

export const prerender = false;

const url = new URL(Astro.request.url);
const params = new URLSearchParams(url.search);
const category = params.get("category");
// console.log(url);

const filteredBuilds = category
	? builds.filter((building) => building.categories.includes(category))
	: builds;
---

<Layout title="Welcome to Astro.">
	<main class="banner">
		<div class="banner-overlay"></div>
		<main class="container banner-content">
			<div class="logotype">
				<img src="img/logo.png" alt="Logo">
				<span>ONE BUILD</span>
			</div>
			<h1 class="slogan">
				Products from <span class="text-gradient">Professional</span> Builders
				at Good Prices
			</h1>
			<div class="banner-buttons">
				<a href="" class="btn">
					<IconDiscord/> Order a custom project
				</a>
				<a href="#builds" class="btn">
					<IconShop/> See our prefabric builds
				</a>
			</div>
		</main>
	</main>
	<section id="builds" class:list={["container"]}>
		<ul role="list" class="link-card-grid">
			{
				filteredBuilds.map((building) => (
					<Card building={building as Building} />
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.banner {
		width: 100%;
		max-width: 100%;
		height: 100vh;
		max-height: 100vh;
		margin-bottom: 4rem;
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-image: url("img/banner.png");
		background-size: cover;
		background-position: center;
		color: var(--stari-text-color-secondary);
	}
	.banner-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		/* background: inherit; */
		backdrop-filter: blur(5px) brightness(0.7);
		background: radial-gradient(
			circle,
			rgba(0, 0, 0, 0) 50%,
			rgba(0, 0, 0, 0.413) 100%
		);
		z-index: 1;
	}
	.banner-content {
		z-index: 2;
		max-width: 960px;
	}
	.banner-buttons{
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.logotype{
		position: absolute;
		left: 50%;
		transform: translateY(-100%) translateX(-50%);
		height: 3rem;
		max-height: 3rem;
		font-size: 1.5rem;
		line-height: 1;
		font-weight: 700;
		color: var(--stari-text-color-important);
		background-color: var(--stari-bg-color-important);
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: auto;
		width: fit-content;
	}
	.logotype>span{
		vertical-align: bottom;
	}
	.logotype>img{
		height: 100%;
		width: auto;
		aspect-ratio: 1;
	}
	
	.slogan {
		line-height: unset;
		margin-top: 1rem;
		margin-bottom: 2rem;
		font-weight: 700;
		font-size: 3rem;
		text-align: center;
		color: var(--stari-text-color-secondary);
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(26ch, 35ch));
		justify-content: center;
		gap: 2rem;
		padding: 0;
		margin: 0;
	}
</style>

<script>
	const urlSearchParams = new URLSearchParams(window.location.search);
	const params = Object.fromEntries(urlSearchParams.entries());
</script>
