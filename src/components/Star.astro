---
interface StarProps {
  fillPercentage: number; // Percentage of the star that should be filled
  roundness?: number; // The roundness of the star, default is 0 (no rounding)
}

const { fillPercentage, roundness = 6 } = Astro.props;
---
<div style={{ position: "relative", width: "24px", height: "24px" }}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="24px"
    height="24px"
    style={{ position: "absolute", top: 0, left: 0 }}
  >
    <path
      d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
      fill="gray"
      stroke="gray"
      stroke-width={roundness}
      stroke-linejoin="round"
      stroke-linecap="round"
    />
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="24px"
    height="24px"
    style={{
      position: "absolute",
      top: 0,
      left: 0,
      clipPath: `inset(0 ${100 - fillPercentage}% 0 0)`,
    }}
  >
    <path
      d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
      fill="gold"
      stroke="gold"
      stroke-width={roundness}
      stroke-linejoin="round"
      stroke-linecap="round"
    />
  </svg>
</div>
