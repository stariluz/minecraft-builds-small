---
interface Props {
    class?:string;
}
const {class:className}=Astro.props;
---
<div class:list={["burger",className]} id="burger">
    <div class="line"></div>
    <div class="line"></div>
    <div class="line"></div>
</div>

<style>
    .burger {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        aspect-ratio: 1;
        max-width: 2rem;
        max-height: 2rem;
        height: 100%;
        width: 100%;
    }

    .burger .line {
        width: 100%;
        height: 10%;
        background-color: var(--stari-header-text-color);
        margin: 10%;
        border-radius: 2rem;
    }

    @media (max-width: 768px) {
        .burger {
            display: flex;
        }
    }
</style>
