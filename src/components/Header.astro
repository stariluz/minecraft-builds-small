<header class="header" id="header">
    <nav class="header-content">
        <a href="?category=Assets#builds">Assets</a>
        <a href="?category=Lobby#builds">Lobby</a>
        <a href="/">
            <img class="logo" src="/img/logo.png" alt="logo" srcset="" />
        </a>
        <a href="?category=Road#builds">Road</a>
        <a href="?category=Castle#builds">Castle</a>
    </nav>
</header>

<style>
    .header {
        position: fixed;
        /* top: 0;
        left: 0; */
        height: 6.5rem;
        margin: auto;
        padding: 1rem 2rem;
        width: calc(100% - 2rem - 3rem);
        max-width: calc(var(--stari-container-max-width) - 2rem);
        z-index: 1000;
        transition: transform 0.3s ease-in-out;
    }
    .header-content {
        position: relative;
        box-sizing: border-box;
        max-width: 100%;
        width: 100%;
        background-color: var(--stari-header-bg-color);
        color: var(--stari-header-text-color);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        height: 100%;
        padding: 0.5rem 2rem;
        box-shadow: 0px 4px 15px 2px var(--stari-header-shadow-color);
    }
    .header-content a {
        height: 100%;
        max-height: 100%;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: var(--stari-header-text-color);
        font-weight: 600;
        font-size: 0.85rem;
    }

    .hidden {
        transform: translateY(-8rem);
    }

    .logo {
        height: 100%;
        width: auto;
        aspect-ratio: 1;
    }
</style>

<script>
    let lastScrollTop = 0;
    const header = document.getElementById("header") as HTMLElement;

    window.addEventListener("scroll", () => {
        const scrollTop =
            window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Scroll hacia abajo - Ocultar el header
            header.classList.add("hidden");
        } else {
            // Scroll hacia arriba - Mostrar el header
            header.classList.remove("hidden");
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop; // Para evitar valores negativos
    });
</script>
