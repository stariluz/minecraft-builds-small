---
import BurguerButton from "./buttons/BurguerButton.astro";

interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<header class:list={["header", className]} id="header">
    <nav class="header-content header-content-min">
        <BurguerButton />
        <a href="/" class="logo-nav">
            <img class="logo" src="/img/logo.png" alt="logo" srcset="" />
        </a>
    </nav>
    <nav class="header-content" id="header-content">
        <a href="?category=Assets#builds">Assets</a>
        <a href="?category=Lobby#builds">Lobby</a>
        <a href="/" class="logo-nav">
            <img class="logo" src="/img/logo.png" alt="logo" srcset="" />
        </a>
        <a href="?category=Road#builds">Road</a>
        <a href="?category=Castle#builds">Castle</a>
    </nav>
</header>

<style>
    .space {
        position: relative;
        opacity: 0;
    }
    .header.fixed {
        position: fixed;
    }
    .header {
        /* top: 0;
        left: 0; */
        height: 6.5rem;
        margin: auto;
        padding: 1rem 2rem;
        width: calc(100% - 2rem - 3rem);
        max-width: calc(var(--stari-container-max-width) - 2rem);
        z-index: 1000;
        transition: transform 0.3s ease-in-out;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-content {
        position: relative;
        box-sizing: border-box;
        max-width: 100%;
        width: 100%;
        background-color: var(--stari-header-bg-color);
        color: var(--stari-header-text-color);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        height: 100%;
        padding: 0.5rem 2rem;
        box-shadow: 0px 4px 15px 2px var(--stari-header-shadow-color);
    }
    .header-content-min {
        display: none;
    }
    .header-content a {
        max-height: 100%;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: var(--stari-header-text-color);
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 4px;
    }
    .header-content a:not(.logo-nav){
        padding: 0.5rem 1rem;
    }
    .header-content a.logo-nav{
        height: 100%;
    }

    .header-content a:not(.logo-nav):hover {
        background-color: var(--stari-header-shadow-color);
    }

    .hidden {
        transform: translateY(-8rem);
    }

    .logo {
        height: 100%;
        width: auto;
        aspect-ratio: 1;
    }

    @media (max-width: 768px) {
        .header-content {
            display: flex;
            flex-direction: column;
            gap: 0px;
            width: 100%;
            background-color: #f8f8f8; /* Fondo opcional para el menú desplegable */
            padding: 10px 0;
            position: absolute;
            top: 60px; /* Ajusta según la altura del header */
            left: 0;
            top: 100%;
            height: fit-content;
            transition: 0.5s cubic-bezier(0.075, 0.82, 0.165, 1) transform;
            transition: 0.5s cubic-bezier(0.075, 0.82, 0.165, 1) opacity;
            transform: translateY(-200%);
            opacity: 0;
        }
        .header-content a:not(.logo-nav){
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 5px;
        }

        .header-content-min {
            top: unset;
            height: 4rem;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            padding: 0.5rem 2rem;
            transform: none;
            opacity: unset;
        }
        .header-content.active {
            transition: 0.5s cubic-bezier(0.075, 0.82, 0.165, 1) transform;
            transition: 0.5s cubic-bezier(0.075, 0.82, 0.165, 1) opacity;
            transform: translateY(0%);
            opacity: 100;
        }
        .header-content:not(.header-content-min) .logo-nav {
            display: none;
        }
    }
</style>

<script>
    let lastScrollTop = 0;
    const header = document.getElementById("header") as HTMLElement;

    window.addEventListener("scroll", () => {
        const scrollTop =
            window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Scroll hacia abajo - Ocultar el header
            header.classList.add("hidden");
        } else {
            // Scroll hacia arriba - Mostrar el header
            header.classList.remove("hidden");
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop; // Para evitar valores negativos
    });

    document.getElementById("burger")!.addEventListener("click", function () {
        const nav = document.getElementById("header-content");
        nav!.classList.toggle("active");
    });
</script>
