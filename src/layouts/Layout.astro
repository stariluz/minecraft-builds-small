---
import Header from "../components/Header.astro";

interface Props {
	title: string;
	class?: string;
}

const { class: className, title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="colors measures concepts entities">
		<header class:list={["container", className]}>
			<Header />
		</header>
		<slot />
	</body>
</html>
<style is:global>
	.measures * {
		--stari-container-max-width: 1200px;
	}
	.colors * {
		--stari-color-1-rgb: 255, 194, 0;
		--stari-color-1: rgb(var(--stari-color-1-rgb));
		--stari-color-2: rgb(255, 255, 255);
		--stari-color-3: rgb(31, 29, 29);
		--stari-color-4: rgb(195, 195, 195);
		--stari-color-5: rgb(255, 49, 49);
		--stari-color-6: rgb(16, 103, 196);
		--stari-shadow-1: rgba(84, 84, 84, 0.162);
		--stari-text-color-1: var(--stari-color-3);
		--stari-text-color-2: var(--stari-color-2);
		--stari-text-color-3: var(--stari-color-1);
		--stari-text-color-4: var(--stari-color-4);
		--stari-text-color-5: var(--stari-color-6);
		--stari-bg-color-1: var(--stari-color-2);
		--stari-bg-color-2: var(--stari-color-1);
		--stari-bg-color-3: var(--stari-color-3);
		--stari-bg-color-4: var(--stari-color-5);
		--stari-accent-1: var(--stari-color-1-rgb);
		--stari-accent-light-1: 255, 235, 132;
		--stari-accent-dark-1: 206, 157, 0;
		--stari-accent-gradient-1: linear-gradient(
			45deg,
			rgb(var(--stari-accent-1)),
			rgb(var(--stari-accent-light-1)) 30%,
			white 60%
		);
		--stari-accent-gradient-2: linear-gradient(
			45deg,
			rgb(var(--stari-accent-dark-1)) 0%,
			rgb(var(--stari-accent-1)) 40%,
			rgb(var(--stari-accent-light-1)) 100%
		);
	}
	.concepts * {
		--stari-bg-color-dark: var(--stari-color-3);
		--stari-bg-color-primary: var(--stari-bg-color-1);
		--stari-bg-color-secondary: var(--stari-bg-color-2);
		--stari-bg-color-important: var(--stari-bg-color-3);
		--stari-bg-color-highlight: var(--stari-bg-color-4);
		--stari-text-color-primary: var(--stari-text-color-1);
		--stari-text-color-secondary: var(--stari-text-color-2);
		--stari-text-color-important: var(--stari-text-color-3);
		--stari-text-color-minor: var(--stari-text-color-4);
		--stari-text-color-link: var(--stari-text-color-5);
		--stari-shadow-color-primary: var(--stari-shadow-1);
	}
	.entities * {
		--stari-header-bg-color: var(--stari-bg-color-primary);
		--stari-header-text-color: var(--stari-text-color-primary);
		--stari-header-shadow-color: var(--stari-shadow-color-primary);
		--stari-btn-color-primary: var(--stari-bg-color-important);
		--stari-btn-color-secondary: var(--stari-bg-color-primary);
		--stari-btn-outline-color-secondary: var(--stari-bg-color-secondary);
	}

	html {
		font-family: system-ui, sans-serif;
		/* background: #13151a; */
	}
	body {
		margin: 0;
	}
	* {
		box-sizing: border-box;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1;
		margin-bottom: 1rem;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	.container {
		margin: auto;
		width: calc(100% - 2rem);
		max-width: var(--stari-container-max-width);
		padding: 1rem;
		color: var(--stari-text-color-primary);
		font-size: 16px;
		line-height: 1.6;
	}
	header.container {
		padding-top: 0;
		padding-bottom: 0;
	}
	a.btn {
		text-decoration: none;
		color: var(--stari-btn-color-secondary);
	}
	.btn {
		font-weight: 600;
		color: var(--stari-btn-color-secondary);
		background: var(--stari-accent-gradient-2);
		padding: 0.5rem 1rem;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		border-radius: 4px;
	}
	.text-gradient {
		background-image: var(--stari-accent-gradient-1);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
</style>
